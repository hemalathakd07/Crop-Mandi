# PostgreSQL is the intended production database.
# Example:
# DATABASE_URL=postgresql+psycopg://cropmandi:cropmandi@localhost:5432/cropmandi
#
# Local development without Docker may use SQLite. Do not treat SQLite as production.
DATABASE_URL=postgresql+psycopg://cropmandi:cropmandi@localhost:5432/cropmandi

# Optional directory of official Coffee Board PDFs already obtained by the team.
# Original files are only read; they are copied into data/raw/coffee_board/.
CROPMANDI_COFFEE_PDF_DIR=

# HTTP timeout for official publishers (seconds)
CROPMANDI_HTTP_TIMEOUT=45

# AGMARKNET / data.gov.in (Rice). Get a key from https://data.gov.in/
# Leave empty to run without live Rice verification.
DATA_GOV_API_KEY=
DATA_GOV_HISTORICAL_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
DATA_GOV_DAILY_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# data.gov.in API key for AGMARKNET Rice price data
# Get from https://data.gov.in/
DATA_GOV_API_KEY=

# Optional Cold Storage extras. Leave empty unless you intentionally configure them.
# Do not put real secrets in this file. Geocoding stays off unless you set it true locally.
FIREBASE_SERVICE_ACCOUNT_JSON=firebase-service-account.json
ORS_API_KEY=
GOOGLE_MAPS_API_KEY=
COLD_STORAGE_ENABLE_GEOCODING=false

# Razorpay TEST MODE keys. Copy to local .env — never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
